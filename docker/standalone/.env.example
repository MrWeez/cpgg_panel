# Docker-only settings for CtrlPanel standalone compose.
# Copy to `.env` next to compose.yaml: `cp .env.example .env`
# Panel app config (.env inside container) is NOT set here,
# it is written by web-installer at /installer.

# MariaDB service credentials, must match what you type in installer.
MYSQL_DATABASE=ctrlpanel
MYSQL_USER=ctrlpaneluser
MYSQL_PASSWORD=changeit
MYSQL_ROOT_PASSWORD=changeit

# CtrlPanel uses same creds as MariaDB by default, override only if needed.
CTRLPANEL_DB_DATABASE=${MYSQL_DATABASE}
CTRLPANEL_DB_USER=${MYSQL_USER}
CTRLPANEL_DB_PASSWORD=${MYSQL_PASSWORD}

# Trust reverse proxy / tunnel headers, passed as TRUSTED_PROXIES to app.
CTRLPANEL_TRUSTED_PROXIES=*
